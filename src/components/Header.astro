---
// ↓ Importamos los Lucide Icons que vamos a usar dentro de nuestro Header
import {
  ChevronRight,
  ChevronLeft,
  User,
  House,
  HeartHandshake,
  NotebookPen,
  FolderCode,
  Rocket,
  Cat,
  GitBranch,
  FolderGit2,
  UserRoundSearch,
} from "@lucide/astro";
---

<header class="header-site">
  <!-- * Header: Representa el encabezado del documento HTML, usualmente suele ser replicable y genérico dentro del abanico de la página web -->
  <div class="header-wrapper">
    <h1 class="titulo-principal hidden-item">
      <ChevronRight size={20} stroke-width={10} />
      Portafolio Personal
      <ChevronLeft size={20} stroke-width={10} />
      <br />
      José Luis Ramírez Sánchez
    </h1>

    <div class="nav-container">
      <nav id="indice" class="indice hidden" aria-label="Índice de Contenido">
        <!-- ? Nav: Nos permite tener un sistema de navegación en nuestra web, puede verse como un índice propio e integrado -->
        <a href="#bienvenido">
          <House size={13} stroke-width={3} />
          <span class="nav-text"> Inicio </span>
        </a>
        <a href="#mi-vida">
          <User size={13} stroke-width={3} />
          <span class="nav-text"> Mi Vida </span>
        </a>
        <a href="#aficiones">
          <NotebookPen size={13} stroke-width={3} />
          <span class="nav-text"> Aficiones </span>
        </a>
        <a href="#mis-gustos">
          <HeartHandshake size={13} stroke-width={3} />
          <span class="nav-text"> Mis Gustos </span>
        </a>
        <a href="#mis-proyectos">
          <FolderCode size={13} stroke-width={3} />
          <span class="nav-text"> Mis Proyectos </span>
        </a>
        <a href="#tecnologias-de-interes">
          <Rocket size={13} stroke-width={3} />
          <span class="nav-text"> Tecnologías de Interés </span>
        </a>
        <a href="#curiosidades">
          <Cat size={13} stroke-width={3} />
          <span class="nav-text"> Curiosidades </span>
        </a>
      </nav>
      <nav
        id="indice-redes-sociales"
        class="indice hidden"
        aria-label="Redes Sociales"
      >
        <a
          href="https://github.com/Kat404"
          target="_blank"
          rel="noreferrer noopener"
          aria-label="Perfil de GitHub"
        >
          <GitBranch size={13} stroke-width={3} />
          <span class="nav-text"> GitHub </span>
        </a>
        <a
          href="https://codeberg.org/Kat404"
          target="_blank"
          rel="noreferrer noopener"
          aria-label="Perfil de Codeberg"
        >
          <FolderGit2 size={13} stroke-width={3} />
          <span class="nav-text"> Codeberg </span>
        </a>
        <a
          href="https://www.reddit.com/user/Kat_404"
          target="_blank"
          rel="noreferrer noopener"
          aria-label="Perfil de Reddit"
        >
          <UserRoundSearch size={13} stroke-width={3} />
          <span class="nav-text"> Reddit </span>
        </a>
      </nav>
    </div>
  </div>
  <!-- ? targer="_blank" significa que redirigirá a la página seleccionable pero en una Nueva Pestaña -->
  <!--
    * a: Representa un enlace o redireccionamiento entre la misma página o hacia otra
    ? target: Define el destino del enlace o del redireccionamiento
    ? rel: Define la relación entre la página actual y la página enlazada
    ? noreferrer: Define que no se envíe información del navegador al enlace, bueno por motivos de privacidad
  -->
</header>
<script>
  const header = document.querySelector(".header-site");
  let ticking = false;

  window.addEventListener("scroll", () => {
    if (!ticking) {
      window.requestAnimationFrame(() => {
        // Histéresis: Activamos en 80px, desactivamos en 30px.
        // Esto evita el glitch de "TV antigua" al cambiar de tamaño el layout.
        if (window.scrollY > 50) {
          header.classList.add("scrolled");
        } else if (window.scrollY < 30) {
          header.classList.remove("scrolled");
        }
        ticking = false;
      });
      ticking = true;
    }
  });
</script>
